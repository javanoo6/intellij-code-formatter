<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.rqc.cloud-platform</groupId>
  <artifactId>intellijidea-code-formatter</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>formatter-intellij-plugin</module>
    <module>minimal-jar-builder</module>
    <module>formatter-cli</module>
  </modules>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Pin to a stable published release. Update when newer releases are available. -->
    <intellij.version>2024.3.5</intellij.version>
    <!-- Compatible with IntelliJ builds 243.24978 through 243.*. -->
    <python.plugin.version>243.24978.46</python.plugin.version>
    <shfmt.version>3.14.1</shfmt.version>
    <picocli.version>4.7.6</picocli.version>
  </properties>

  <repositories>
    <repository>
      <id>jetbrains-marketplace</id>
      <url>https://plugins.jetbrains.com/maven</url>
    </repository>
    <repository>
      <id>intellij-repository-releases</id>
      <url>https://www.jetbrains.com/intellij-repository/releases</url>
    </repository>
    <repository>
      <id>intellij-dependencies</id>
      <url>https://packages.jetbrains.team/maven/p/ij/intellij-dependencies</url>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.jetbrains.plugins</groupId>
        <artifactId>PythonCore</artifactId>
        <version>${python.plugin.version}</version>
        <type>zip</type>
        <scope>provided</scope>
      </dependency>
      <!-- Full IntelliJ Community distribution ZIP, used to extract formatter JARs -->
      <dependency>
        <groupId>com.jetbrains.intellij.idea</groupId>
        <artifactId>ideaIC</artifactId>
        <version>${intellij.version}</version>
        <type>zip</type>
        <scope>provided</scope>
      </dependency>
      <!-- Lightweight CLI argument parsing -->
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>
