<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.rqc.cloud-platform</groupId>
        <artifactId>intellijidea-code-formatter</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>formatter-cli</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Path to the engine ZIP produced by minimal-jar-builder.
            Build minimal-jar-builder first, then this module:
              mvn package -pl minimal-jar-builder
              mvn package -pl formatter-cli
            The engine ZIP is bundled inside formatter-cli-full.jar as a resource
            and extracted to $TMPDIR/intellij-formatter-engine/ on first run.
        -->
        <engine.zip.path>${project.basedir}/../minimal-jar-builder/target/formatter-engine.zip</engine.zip.path>
    </properties>

    <dependencies>
        <!-- Only real compile dep: CLI argument parsing. No IntelliJ needed here. -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!--
                Step 1 (generate-resources):
                Copy the engine ZIP from the sibling module's target/ into
                target/classes/engine/ so maven-shade-plugin picks it up as a resource.
                failonerror="false" means the build still succeeds if minimal-jar-builder
                hasn't been packaged yet (the fat JAR will just omit the engine).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-engine-zip-to-resources</id>
                        <phase>generate-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.outputDirectory}/engine"/>
                                <delete file="${project.build.outputDirectory}/engine/formatter-engine.zip"
                                        quiet="true"/>
                                <available file="${engine.zip.path}" property="engine.zip.present"/>
                                <fail unless="engine.zip.present"
                                      message="Missing formatter engine ZIP at ${engine.zip.path}. Run `mvn package -pl minimal-jar-builder` successfully first."/>
                                <copy file="${engine.zip.path}"
                                      todir="${project.build.outputDirectory}/engine/"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Step 2 (package):
                Produce formatter-cli-full.jar — a self-contained executable fat JAR:
                  - Main.class, FormatterLauncher.class  (thin launcher, no IntelliJ deps)
                  - picocli classes
                  - engine/formatter-engine.zip           (bundled IntelliJ engine)

                IdeaFormatterStarter and plugin.xml live inside the engine ZIP itself
                (in custom-plugins/ideaformatter/) — built by minimal-jar-builder.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <outputFile>${project.build.directory}/formatter-cli-full.jar</outputFile>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.github.javanoo6.formatter.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
